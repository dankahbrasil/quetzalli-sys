{%- assign collection = section.settings.collection -%}
<section class="qtz" id="sabores">
  <div class="qtz-wrap">
    <div class="qtz-head">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="qtz-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="qtz-h2">{{ section.settings.title }}</h2></div>
      {%- if section.settings.text != blank -%}<p class="qtz-lead" style="max-width:360px">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="qtz-grid">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          {%- assign bg = product.metafields.custom.cor_card.value | default: '#f9ead3' -%}
          <article class="qtz-card">
            <a href="{{ product.url }}" class="qtz-card__media" style="background: {{ bg }}">
              {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 1000px) 25vw, 50vw', alt: product.title }}{%- endif -%}
              {%- if product.metafields.custom.selo.value != blank -%}<span class="qtz-card__badge">{{ product.metafields.custom.selo.value }}</span>{%- endif -%}
            </a>
            <div class="qtz-card__body">
              {%- if product.metafields.custom.destilado.value != blank -%}<div class="qtz-card__kicker">{{ product.metafields.custom.destilado.value }}</div>{%- endif -%}
              <h3 class="qtz-card__title"><a href="{{ product.url }}">{{ product.metafields.custom.frutas.value | default: product.title }}</a></h3>
              {%- if product.metafields.custom.perfil_sabor.value != blank -%}<div class="qtz-card__desc">{{ product.metafields.custom.perfil_sabor.value }}</div>{%- endif -%}
              <div class="qtz-card__price">
                <b>{{ v.price | money }}</b>
                {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
              </div>
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ v.id }}">
                <button type="submit" class="qtz-btn qtz-btn--ink qtz-btn--sm qtz-btn--full" {% unless v.available %}disabled{% endunless %}>{% if v.available %}Adicionar{% else %}Esgotado{% endif %}</button>
              {%- endform -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Sabores Quetzalli",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Sobretítulo","default":"Os 4 sabores"},
    {"type":"text","id":"title","label":"Título","default":"Escolhe o seu. Ou leva todos."},
    {"type":"textarea","id":"text","label":"Texto","default":"Garrafa de 750 ml, rende 5 drinks. Sem conservante, corante ou estabilizante."},
    {"type":"collection","id":"collection","label":"Coleção"},
    {"type":"range","id":"limit","label":"Quantidade","min":2,"max":8,"step":1,"default":4}
  ],
  "presets":[{"name":"Sabores Quetzalli"}]
}
{% endschema %}
